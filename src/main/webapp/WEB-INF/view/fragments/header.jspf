<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<header class="site-header no-print">
  <div class="header-inner">
    <a class="brand" href="${pageContext.request.contextPath}/dashboard">
      Sunrise Dental Clinic
      <small>Appointment and Patient Management System</small>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="${pageContext.request.contextPath}/dashboard">Dashboard</a>
      <c:if test="${sessionScope.authUser.role.name() eq 'RECEPTIONIST'}">
        <a href="${pageContext.request.contextPath}/appointments?action=new">New appointment</a>
        <a href="${pageContext.request.contextPath}/appointments">Find appointment</a>
        <a href="${pageContext.request.contextPath}/billing">Billing</a>
      </c:if>
      <c:if test="${sessionScope.authUser.role.name() eq 'DENTIST'}">
        <a href="${pageContext.request.contextPath}/dentist/appointments">My appointments</a>
      </c:if>
      <c:if test="${sessionScope.authUser.role.name() eq 'CLINIC_MANAGER'}">
        <a href="${pageContext.request.contextPath}/reports">Reports</a>
        <a href="${pageContext.request.contextPath}/catalogue">Catalogue &amp; fees</a>
        <a href="${pageContext.request.contextPath}/users">User accounts</a>
      </c:if>
      <a href="${pageContext.request.contextPath}/help">Help</a>
      <form class="logout-form" action="${pageContext.request.contextPath}/logout" method="post">
        <input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}">
        <button class="link-button" type="submit">Exit</button>
      </form>
    </nav>
  </div>
</header>
